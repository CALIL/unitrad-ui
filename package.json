{
  "name": "unitrad-ui",
  "version": "1.12.0",
  "description": "Standard web interface for the Library federated catalog.",
  "main": "index.html",
  "type": "module",
  "scripts": {
    "start": "node tools/build.mjs debug --conf=./conf/",
    "release": "node tools/build.mjs release --conf=./conf/",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "node --import ./tools/tsx-loader-register.mjs --test test/test_*.mts test/test_*.tsx"
  },
  "directories": {
    "test": "test"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "browserslist": "^4.29.1",
    "cssnano": "^9.1.0",
    "ejs": "^6.0.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "minimist": "^1.2.8",
    "postcss": "^8.5.28",
    "sass-embedded": "^1.105.0",
    "spdx-license-list": "^6.12.0",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CALIL/unitrad-ui"
  },
  "author": "CALIL Inc.",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/CALIL/unitrad-ui/issues"
  },
  "homepage": "https://github.com/CALIL/unitrad-ui#readme",
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-paginate": "8.3.0"
  },
  "overrides": {
    "minimatch@^9.0.0": "^10.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "esbuild": true,
    "core-js": false
  }
}
